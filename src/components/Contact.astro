---
const links = [
  { label: "Email", value: "info@edualba.com", href: "mailto:info@edualba.com" },
  { label: "LinkedIn", value: "in/joe-cape", href: "https://www.linkedin.com/in/joe-cape-46b1261b/" },
  { label: "GitHub", value: "View repositories", href: "https://github.com/mihuasi" },
  { label: "Moodle Marketplace", value: "View profile", href: "https://marketplace.moodle.com/user/465" },
];
---

<section class="section section-dark">
  <div class="section-inner">
    <span class="eyebrow">Get in touch</span>
    <h2 class="section-title reveal">Tell me what's broken</h2>
    <p class="section-lead reveal">
      A plugin gap, an integration that half-works, a migration nobody wants to
      own, or overflow work you'd rather hand to someone reliable — all
      welcome. I work at a day rate, remote, across UK and Spanish time zones.
    </p>

    <div class="contact-grid">
      {
        links.map((link) => (
          <a class="contact-card reveal" href={link.href} target="_blank" rel="noopener">
            <div class="label">{link.label}</div>
            <div class="value">{link.value}</div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<footer>
  © {new Date().getFullYear()} Alba Education · Joe Cape · Moodle Development &amp; E-Learning · UK &amp; Spain
</footer>
