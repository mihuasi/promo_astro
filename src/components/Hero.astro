---
// Simple SVG approximation of the card's staircase mark.
// Swap the <svg> below for an <img src="/logo.svg"> once you have the vector
// version of your real logo exported.
---

<section class="hero">
  <div class="hero-inner">
    <div class="logo-lockup">
      <svg class="logo-mark" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="stepGrad" x1="0" y1="48" x2="48" y2="0">
            <stop offset="0%" stop-color="#e8792a" />
            <stop offset="100%" stop-color="#f2a24c" />
          </linearGradient>
        </defs>
        <rect x="4" y="34" width="9" height="10" rx="1.5" fill="url(#stepGrad)" />
        <rect x="15" y="26" width="9" height="18" rx="1.5" fill="url(#stepGrad)" />
        <rect x="26" y="18" width="9" height="26" rx="1.5" fill="url(#stepGrad)" />
        <path d="M26 18 L38 6" stroke="url(#stepGrad)" stroke-width="3" stroke-linecap="round" />
        <path d="M30 6 H38 V14" stroke="url(#stepGrad)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none" />
      </svg>
      <div class="logo-wordmark">
        Alba Education
        <span>Moodle Development &amp; E-Learning · UK &amp; Spain</span>
      </div>
    </div>

    <div class="badge reveal">
      <span class="dot"></span>
      Meet us at MoodleMoot Barcelona
    </div>

    <h1 class="reveal">
      We build the <em>plugins and integrations</em> that make Moodle fit how you actually work
    </h1>

    <p class="lede reveal">
      Custom plugin development, integrations and mobile development for training
      providers, universities and SMEs — delivered as an ongoing service across
      the UK and Spain.
    </p>

    <div class="hero-actions reveal">
      <a class="btn btn-primary" href="mailto:hello@albaeducation.dev">Email us</a>
      <a class="btn btn-outline" href="https://github.com/YOUR-GITHUB" target="_blank" rel="noopener">
        View on GitHub
      </a>
    </div>
  </div>
</section>
