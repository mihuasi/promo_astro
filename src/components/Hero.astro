---
// Swap the inline <svg> for <img src="/logo.svg"> once you have a vector
// export of the real Alba Education mark.
---

<section class="hero">
  <div class="hero-inner">
    <div class="logo-lockup">

<svg class="logo-mark__graphic" width="48" height="48" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-label="Alba Education">
  <rect x="0" y="75" width="26" height="25" fill="#FF7C1C"/>
  <rect x="25" y="50" width="26" height="50" fill="#FF9437"/>
  <rect x="50" y="25" width="26" height="75" fill="#FFAA55"/>
  <rect x="75" y="0" width="25" height="100" fill="#FFC378"/>
</svg>
      <div class="logo-wordmark">
        Alba Education
        <span>Moodle Development &amp; E-Learning · UK &amp; Spain</span>
      </div>
    </div>

    <div class="badge reveal">
      <span class="dot"></span>
      At MoodleMoot Global, Barcelona — October 2026
    </div>

    <h1 class="reveal">
      I build Moodle plugins and integrations that <em>stay built</em>
    </h1>

    <p class="lede reveal">
      Senior PHP and Moodle contractor, 15+ years. Plugin architecture, system
      integrations, large-scale migrations and Flutter mobile apps — for
      universities, training providers and product teams across the UK, Spain
      and the Nordics.
    </p>

    <div class="hero-actions reveal">
      <a class="btn btn-primary" href="mailto:info@edualba.com">Email me</a>
      <a class="btn btn-outline" href="https://github.com/mihuasi" target="_blank" rel="noopener">
        GitHub
      </a>
    </div>

    <p class="hero-footnote reveal">
      Joe Cape, M.A., M.Sc. · Málaga, Spain · working in English and Spanish
    </p>
  </div>
</section>
