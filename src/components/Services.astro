---
const services = [
  {
    title: "Plugin Development",
    description:
      "Custom Moodle plugins designed to survive upgrades. mod_goodhabits is in the public plugin directory; an enrolment plugin I built for a Totara-based product in 2015 was still core to it in 2023.",
    icon: "M4 17l6-6 4 4 6-8",
  },
  {
    title: "Integrations & Migrations",
    description:
      "SSO, REST and GraphQL APIs, Salesforce and HR system connections, and large-scale platform migrations — including one of 800,000 users and several million enrolments.",
    icon: "M8 12h8M12 8v8",
  },
  {
    title: "Mobile Development",
    description:
      "Flutter apps for iOS and Android, built alongside your LMS or standalone. Squiddity is my own, live in both app stores.",
    icon: "M8 3h8a1 1 0 011 1v16a1 1 0 01-1 1H8a1 1 0 01-1-1V4a1 1 0 011-1zM11 18h2",
  },
];
---

<section class="section">
  <div class="section-inner">
    <span class="eyebrow">What I do</span>
    <h2 class="section-title reveal">Development-first Moodle work</h2>
    <p class="section-lead reveal">
      I'm a developer first — the person you bring in when the default install
      isn't enough, the integration is half-working, or a migration has to
      happen without downtime.
    </p>

    <div class="services-grid">
      {
        services.map((service) => (
          <div class="service-card reveal">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={service.icon} />
              </svg>
            </div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        ))
      }
    </div>

    <p class="stack-line reveal">
      <strong>Stack:</strong> PHP (Moodle, Totara, Laravel, Symfony, Zend, Joomla!) ·
      MySQL / PostgreSQL · REST &amp; GraphQL · Flutter / Dart · Vue · React ·
      Docker · AWS · Linux/Apache · Git &amp; CI/CD · PRINCE2 Practitioner
    </p>
  </div>
</section>
