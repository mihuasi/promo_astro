<section class="section">
  <div class="section-inner">
    <span class="eyebrow">What I do</span>
    <h2 class="section-title reveal">Communication-first EdTech solutions</h2>
    <p class="section-lead reveal">
      Over 15 years working with Moodle, Totara and other platforms. Clients highlight my straightforward working style and an open line of communication.
    </p>
    <br />
    <p class="section-lead reveal">
      If you're not yet sure what you're up against, my first job is to give you clarity.
    </p>

    <div class="services-grid">
      {
        services.map((service) => (
          <div class="service-card reveal">
            <div class="service-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={service.icon} />
              </svg>
            </div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
          </div>
        ))
      }
